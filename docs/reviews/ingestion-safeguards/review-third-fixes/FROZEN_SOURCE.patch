+    assert metadata["source_file"] == str(source)
+    assert metadata["line_start"] == 1
+    assert metadata["ingestion_decision"] == "keep"
+    assert json.loads(metadata["ingestion_omissions"]) == {}
+
+
+MALFORMED_TRANSPORT = [
+    '{"rawOutput":{"bytes":[91 92]}}',
