+
+@pytest.mark.parametrize("operation", ["add", "diary"])
+def test_mcp_selected_evidence_and_metadata_remain_aligned(handlers, writer_spies, operation):
+    namespace, events = handlers
+    _, storage, embedded = writer_spies
+    text = json.dumps(
